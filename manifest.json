{
    "name": "X Opener",
    "description": "Chrome extension to open X with a click",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
      "tabs",
      "scripting"
    ],
    "host_permissions": [
      "https://x.com/*",
      "https://twitter.com/*"
    ],
    "action": {
      "default_popup": "hello.html",
      "default_icon": "hello_extensions.png"
    }
}